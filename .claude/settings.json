{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter ./packages/ui exec tsc --noEmit*)",
      "Bash(pnpm --filter ./apps/web exec tsc --noEmit*)",
      "Bash(pnpm --filter @bloco/web exec tsc --noEmit*)",
      "Bash(pnpm exec tsc --noEmit*)",
      "Bash(pnpm -r exec tsc --noEmit*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm test:coverage*)",
      "Bash(pnpm -v)",
      "Bash(pnpm install*)",
      "Bash(sed *)",
      "Bash(perl *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-tokens.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-ui.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
